        "import random\n",
        "\n",
        "N = 4\n",
        "\n",
        "def cost(board):\n",
        "    \"\"\"\n",
        "    Cost function: counts number of attacking pairs of queens.\n",
        "    board[i] = row position of queen in column i.\n",
        "    \"\"\"\n",
        "    conflicts = 0\n",
        "    for i in range(N):\n",
        "        for j in range(i+1, N):\n",
        "            # Same row or same diagonal\n",
        "            if board[i] == board[j] or abs(board[i]-board[j]) == abs(i-j):\n",
        "                conflicts += 1\n",
        "    return conflicts\n",
        "\n",
        "def print_board(board):\n",
        "    \"\"\"Visualize the board with Q and .\"\"\"\n",
        "    for row in range(N):\n",
        "        line = \"\"\n",
        "        for col in range(N):\n",
        "            if board[col] == row:\n",
        "                line += \"Q \"\n",
        "            else:\n",
        "                line += \". \"\n",
        "        print(line)\n",
        "    print()\n",
        "\n",
        "def hill_climb():\n",
        "    board = [random.randint(0, N-1) for _ in range(N)]\n",
        "    print(\"Initial board:\")\n",
        "    print_board(board)\n",
        "    print(\"Initial cost:\", cost(board))\n",
        "\n",
        "    while True:\n",
        "        current_cost = cost(board)\n",
        "        if current_cost == 0:\n",
        "            print(\"Goal reached!\")\n",
        "            return board\n",
        "\n",
        "        # Generate neighbors\n",
        "        neighbors = []\n",
        "        for col in range(N):\n",
        "            for row in range(N):\n",
        "                if row != board[col]:\n",
        "                    new_board = board[:]\n",
        "                    new_board[col] = row\n",
        "                    neighbors.append((cost(new_board), new_board))\n",
        "\n",
        "        # Sort by cost\n",
        "        neighbors.sort(key=lambda x: x[0])\n",
        "        best_cost, best_board = neighbors[0]\n",
        "\n",
        "        print(\"Best neighbor cost:\", best_cost)\n",
        "        print_board(best_board)\n",
        "\n",
        "        if best_cost >= current_cost:\n",
        "            print(\"Stuck at local minimum with cost:\", current_cost)\n",
        "            return board\n",
        "\n",
        "        board = best_board\n",
        "\n",
        "solution = hill_climb()\n",
        "print(\"Final solution:\", solution)\n",
        "print_board(solution)\n",
        "\n"
      ]
